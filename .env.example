# Copy to .env and fill in. Never commit .env. Never put a real value in this file.

APP_ENV=local
LOG_LEVEL=INFO

# Inside Docker the host is the compose service name, not localhost.
DATABASE_URL=postgresql+psycopg://argus:argus@db:5432/argus
DB_STATEMENT_TIMEOUT_MS=2000

# Read-only, fine-grained. NFR-007.
GITHUB_TOKEN=

JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Ollama runs on the host, not in a container. DEC-017.
# From inside the api container use host.docker.internal, not localhost.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_ATTEMPTS=3

SYNC_INTERVAL_MINUTES=5
EVIDENCE_WINDOW_DAYS=14
FRESHNESS_WARN_MINUTES=30
FRESHNESS_STALE_MINUTES=120
